# FloodSense Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── Google AI (FREE via AI Studio) ───────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Firebase (FREE Spark Plan) ────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (for backend agents)
# Download from Firebase Console → Project Settings → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ─── Twilio (FREE Trial) ────────────────────────────────────────────────────────
# Sign up free at: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx      # Your Twilio trial number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886  # Twilio WhatsApp sandbox

# ─── Mapbox (FREE 50k loads/month) ───────────────────────────────────────────
# Get free key at: https://account.mapbox.com/
# Maps: Using free Leaflet + OpenStreetMap — NO KEY NEEDED

# ─── Mock APIs (local json-server) ───────────────────────────────────────────
JPS_API_BASE_URL=http://localhost:3001   # Local mock JPS API
MOCK_API_PORT=3001

# ─── Internal Secrets ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_string
ADK_AGENT_SECRET=change_this_internal_agent_secret

# ─── App Config ──────────────────────────────────────────────────────────────
APP_ENV=development   # development | production
LOG_LEVEL=INFO
