rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HACKATHON MODE: Allow all reads and writes (no auth required)
    // This enables REST API calls from Python agents without a service account.
    // TODO: Replace with role-based rules before any production deployment.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
