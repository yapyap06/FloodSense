# Next.js Dashboard — environment variables
# Copy to .env.local and fill in values
# DO NOT commit .env.local

# Firebase (from Firebase Console → Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=floodsense-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=floodsense-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=floodsense-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Mapbox REMOVED — using free Leaflet + OpenStreetMap instead (no key needed!)

# Set to "true" when running against Firebase emulator locally
NEXT_PUBLIC_USE_EMULATOR=true
